# Generate all values with a cryptographically secure generator. Never commit
# the real .env file or publish these credentials.
MINIO_ROOT_USER=minio-root-admin
MINIO_ROOT_PASSWORD=replace-with-at-least-32-random-characters
PBX_MINIO_ACCESS_KEY=pbx-recordings-writer
PBX_MINIO_SECRET_KEY=replace-with-at-least-32-random-characters
PBX_MINIO_BUCKET=pbx-recordings
PBX_MINIO_PREFIX=pbx/recordings
PBX_CALL_WEBHOOK_INBOX_BY_EXTENSION=

# Tracing (Grafana Tempo, optional). De trong = tat. Khi stack observability chay, dat: tempo:4317
# (dang host:port cho OTLP/gRPC; http://tempo:4317 cung duoc). Ty le lay mau: OTEL_TRACES_SAMPLER_ARG (mac dinh 1.0).
CUSTOMPBX_OTEL_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
