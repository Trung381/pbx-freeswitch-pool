# Install as /etc/pbx-firewall/sip-allowlist.env (mode 0600).
# Space-separated CIDRs are supported. Do not put keys or passwords here.
WAN_INTERFACE=ens192
WG_INTERFACE=wg0
WG_PORT=51820
SIP_PORTS=5060,5061,5080
RTP_PORT_RANGE=16384:16399

# OneConnect signalling endpoint currently configured on this PBX.
TRUNK_SIP_CIDRS="125.212.225.105/32"
# Keep this carrier range until a successful production call proves a narrower
# RTP source range. Do not set this to 0.0.0.0/0.
TRUNK_RTP_CIDRS="125.212.225.0/24"
