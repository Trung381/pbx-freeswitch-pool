# Sao chep thanh .env (chmod 600). KHONG commit .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana chi nghe tren IP WireGuard (wg0). Dat 127.0.0.1 de test local qua ssh tunnel.
GRAFANA_BIND_ADDR=10.77.0.1
GRAFANA_ROOT_URL=http://10.77.0.1:3000
# Mat khau user Postgres chi doc `grafana_ro` (xem postgres/create-grafana-ro.sql)
GRAFANA_PG_PASSWORD=
# Telegram: de trong cho den khi co bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Retention metrics (log 5 ngay dat trong loki/loki.yml: retention_period 120h)
PROM_RETENTION_TIME=10d
PROM_RETENTION_SIZE=1GB
# Ten volume log FreeSWITCH (project compose chinh + _freeswitch-logs)
FS_LOG_VOLUME=pbx-freeswitch-pool_freeswitch-logs
