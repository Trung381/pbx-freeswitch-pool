   "options": {
    "showHeader": true
   },
   "description": "Trang thai lay tu su kien sofia::gateway_state ke tu luc custompbx khoi dong. REGED = da dang ky.",
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true
      }
     }
    }
   ]
