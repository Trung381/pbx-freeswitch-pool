       {
        "color": "#1c7ed6",
        "value": null
       }
      ]
     },
     "noValue": "Chua co du lieu (chua co cuoc goi/su kien)",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
