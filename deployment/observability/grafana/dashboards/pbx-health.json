  {
   "id": 6,
   "type": "stat",
   "title": "HEP packets/s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(pbx_hep_packets_total{result=\"received\"}[$__rate_interval]))",
     "instant": false,
     "range": true
    }
   ],
   "gridPos": {
