  {
   "id": 8,
   "type": "timeseries",
   "title": "Cuoc goi ket thuc theo hangup cause (/phut)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (hangup_cause) (increase(pbx_calls_total[$__rate_interval])) * 60 / $__interval_ms * 1000",
     "instant": false,
     "range": true,
     "legendFormat": "{{hangup_cause}}"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "Chua co du lieu (chua co cuoc goi/su kien)",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true,
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
