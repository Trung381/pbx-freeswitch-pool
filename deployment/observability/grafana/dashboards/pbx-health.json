{
 "uid": "pbx-health",
 "title": "PBX - Suc khoe he thong",
 "tags": [
  "pbx",
  "health"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "custompbx /metrics",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"custompbx\"}",
     "instant": false,
     "range": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#e03131",
        "value": null
       },
       {
        "color": "#2f9e44",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "#e03131"
        },
        "1": {
         "text": "UP",
         "color": "#2f9e44"
        }
       }
      }
     ],
     "noValue": "Chua co du lieu (chua co cuoc goi/su kien)"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "description": "Prometheus scrape custompbx qua cong 9102 (noi bo docker, khong publish). DOWN = custompbx chet hoac chua co endpoint /metrics."
  },
