   "title": "custompbx: RAM (RSS) / goroutines",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "process_resident_memory_bytes{job=\"custompbx\"}",
     "instant": false,
     "range": true,
     "legendFormat": "RSS"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "go_goroutines{job=\"custompbx\"}",
     "instant": false,
