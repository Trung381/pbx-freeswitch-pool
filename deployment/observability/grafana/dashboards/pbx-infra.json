     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) (changes(container_start_time_seconds{name=~\"freeswitch-host|custompbx-host|postgres-host|pbx-freeswitch-pool-minio-.*|pbx-obs.*|.*grafana.*|.*loki.*|.*prometheus.*|.*alloy.*|.*cadvisor.*|.*node-exporter.*\"}[1h]))",
