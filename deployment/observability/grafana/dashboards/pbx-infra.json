   ],
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#e03131",
        "value": null
       },
       {
        "color": "#f08c00",
        "value": 10
       },
       {
        "color": "#2f9e44",
        "value": 20
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "description": "MemAvailable / MemTotal. Canh bao khi < 10%."
  },
  {
