    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name) (time() - container_start_time_seconds{name=~\"freeswitch-host|custompbx-host|postgres-host|pbx-freeswitch-pool-minio-.*|pbx-obs.*|.*grafana.*|.*loki.*|.*prometheus.*|.*alloy.*|.*cadvisor.*|.*node-exporter.*\"})",
